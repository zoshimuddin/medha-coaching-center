# Protect dev / database / archive files from public web access.
# Hostinger's GitHub auto-deploy copies the whole repo into public_html,
# so we deny direct requests to the non-website files here.
<FilesMatch "\.(md|sql|zip|ts|example)$">
  Require all denied
</FilesMatch>

# Deny any dotfile (.gitignore, .env.example, ...)
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# PWA: serve the web app manifest with its proper MIME type.
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
</IfModule>

# Never cache website files — Hostinger git deploys go live instantly.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|css)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
